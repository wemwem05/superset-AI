# =============================================================================
# Superset Environment Variables
# =============================================================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.

# --- Superset Admin ---
SUPERSET_ADMIN_USERNAME=data
SUPERSET_ADMIN_FIRSTNAME=Data
SUPERSET_ADMIN_LASTNAME=Data
SUPERSET_ADMIN_EMAIL=data@1fit.app
SUPERSET_ADMIN_PASSWORD=CHANGE_ME

# --- PostgreSQL ---
POSTGRES_USER=superset
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=superset
DATABASE_HOST=postgres
DATABASE_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Celery ---
# Broker URL used by celery workers and healthcheck (celery inspect ping).
# Must match CeleryConfig.broker_url in superset_config.py (Redis DB 4).
CELERY_BROKER_URL=redis://redis:6379/4

# --- Superset ---
# Generate once: openssl rand -base64 42
# NEVER rotate after first deployment — it encrypts saved DB credentials.
SUPERSET_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL
SUPERSET_PORT=8088

# --- S3 Backup (REL-01) ---
# Required for automated PostgreSQL backups to S3-compatible storage.
# Create a bucket and IAM credentials with PutObject/DeleteObject permissions.
S3_REGION=us-east-1
S3_BUCKET=my-superset-backups
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
# Uncomment for non-AWS S3-compatible providers (e.g., Cloudflare R2, MinIO):
# S3_ENDPOINT=https://your-s3-endpoint.example.com
